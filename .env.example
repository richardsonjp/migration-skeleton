# Database Configuration
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_NAME=your_database_name
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=disable

# Comma-separated list of schemas to manage. Each one maps to
# cmd/apiserver/app/migrations/<schema>/ and is created if missing.
# Examples: DB_SCHEMAS=public | DB_SCHEMAS=app,analytics
DB_SCHEMAS=app
